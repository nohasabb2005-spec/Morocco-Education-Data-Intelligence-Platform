    ROW_NUMBER() OVER (ORDER BY p.code_region, p.province) AS province_id,

    r.region_id,

    p.code_region,

    p.province

FROM provinces p

LEFT JOIN "education_db"."gold"."dim_region" r
    ON p.code_region = r.code_region

ORDER BY p.code_region, p.province
  );
  
