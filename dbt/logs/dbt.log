        WHEN acces_internet = 0 THEN FALSE
        ELSE NULL
      END AS acces_internet,

      CASE
        WHEN cantine = 1 THEN TRUE
        WHEN cantine = 0 THEN FALSE
        ELSE NULL
      END AS cantine,

      latitude,
      longitude
from bronze.etablissements
  );
  
