  create  table "education_db"."gold"."fact_abandons__dbt_tmp"
  
  
    as
  
  (
    

SELECT

    a.id_abandon AS abandon_id,

    d.date_id,

    p.province_id,

    c.cycle_id,

    g.genre_id,

    a.niveau_classe,

