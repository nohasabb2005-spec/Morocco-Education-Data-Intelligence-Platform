    as
  
  (
    

SELECT

    TRIM(id_eleve) AS id_eleve,
    TRIM(annee_scolaire) AS annee_scolaire,
    TRIM(region) AS region,
    TRIM(code_region) AS code_region,
    TRIM(province) AS province,
    TRIM(milieu) AS milieu,
    TRIM(secteur) AS secteur,
